NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
LOG_LEVEL=info
TZ=Asia/Jakarta

WA_AUTH_DIR=.wa-auth
WA_ENABLED=true

ALLOWED_SENDERS=693xxxxxxxxx@lid
ALERT_TARGET=693xxxxxxxxx@lid

ALERT_CRON=0 8 * * *

TMS_API_BASE_URL=
TMS_API_KEY=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=10

NODE_ENV=production
LOG_LEVEL=info
LOG_FILE_PATH=/app/logs/app.log

# allow personal chat
ALLOW_PERSONAL=true

# allow group chat
ALLOW_GROUP=true

# whitelist personal (comma separated JID)
ALLOWED_USERS=628xxxx@s.whatsapp.net,628yyy@s.whatsapp.net

# whitelist group JID
ALLOWED_GROUPS=1203630xxxxx@g.us